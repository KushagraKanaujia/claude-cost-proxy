{
  "name": "claude-cost-proxy",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -e '.[dev]'",
  "postAttachCommand": "claude-proxy-demo",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "claude-proxy", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    },
    "codespaces": {
      "openFiles": ["README.md", "claude_cost_proxy/server.py"]
    }
  }
}
